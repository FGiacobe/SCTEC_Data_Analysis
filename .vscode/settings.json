{
  "editor.fontFamily": "VictorMono Nerd Font",
  "editor.fontSize": 12,
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "VictorMono Nerd Font",
  "terminal.integrated.fontSize": 10,
  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.executorMap": {
    "python": "uv run python"
  },
  "ruff.enable": true,
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "gitlens.codeLens.symbolScopes": [
      "!Module"
    ],
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "strict",
  "notebook.output.fontFamily": "VictorMono Nerd Font",
  "notebook.output.fontSize": 12,
  "notebook.output.scrolling": true,
  "notebook.output.wordWrap": false,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "chat.tools.terminal.autoApprove": {
    "git remote": true,
    "git submodule": true,
    "git -C packages/elections": true
  }
}
