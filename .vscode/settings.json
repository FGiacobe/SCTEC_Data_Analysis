{
  "editor.fontFamily": "VictorMono Nerd Font",
  "editor.fontSize": 12,
  "editor.fontLigatures": true,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.jj": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    ".git/objects/**": true,
    ".git/subtree-cache/**": true,
    ".hg/store/**": true,
    "*/.git/objects/**": true,
    "*/.git/subtree-cache/**": true,
    "*/.hg/store/**": true,
    ".venv/**": true
  },
  "terminal.integrated.fontFamily": "VictorMono Nerd Font",
  "terminal.integrated.fontSize": 10,
  "[markdown]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "editor.quickSuggestions": {
      "comments": "inline",
      "strings": "inline",
      "other": "inline"
    }
  },
  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.executorMap": {
    "python": "uv run python"
  },
  "ruff.enable": true,
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "gitlens.codeLens.symbolScopes": [
      "!Module"
    ],
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "strict",
  "notebook.output.fontFamily": "VictorMono Nerd Font",
  "notebook.output.fontSize": 12,
  "notebook.output.scrolling": true,
  "notebook.output.wordWrap": false,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "chat.tools.terminal.autoApprove": {
    "git remote": true,
    "git submodule": true,
    "git -C packages/elections": true
  }
}
